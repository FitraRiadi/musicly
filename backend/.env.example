# Copy this file to backend/.env and fill in your own local values.
# Never commit backend/.env or any real production credentials.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL
POSTGRES_DB=musicly
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Browser origins allowed to call the API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upstream APIs
DEEZER_API=https://api.deezer.com
LRCLIB_API=https://lrclib.net/api

# Local ytmp3 scraper for full-track streaming (empty = previews only)
YTMP3_API=http://127.0.0.1:8137
